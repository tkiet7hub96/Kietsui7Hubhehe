-- ==================== LOGIC BAY (FLY LOGIC) ====================
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local flying = false
local speed = 1
local flySpeedMultiplier = 50
local bg, bv

local function startFly()
    if not character or not humanoidRootPart then return end
    
    flying = true
    FlyToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 205, 50) -- Đổi sang xanh khi bật
    
    local camera = workspace.CurrentCamera
    
    bg = Instance.new("BodyGyro")
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = humanoidRootPart.CFrame
    bg.Parent = humanoidRootPart
    
    bv = Instance.new("BodyVelocity")
    bv.velocity = Vector3.new(0, 0, 0)
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = humanoidRootPart
    
    humanoid.PlatformStand = true
    
    task.spawn(function()
        while flying do
            task.wait()
            local camCF = camera.CFrame
            local moveDir = Vector3.new(0, 0, 0)
            
            -- Hướng di chuyển cơ bản (W, A, S, D)
            local uis = game:GetService("UserInputService")
            if uis:IsKeyDown(Enum.KeyCode.W) then
                moveDir = moveDir + camCF.LookVector
            end
            if uis:IsKeyDown(Enum.KeyCode.S) then
                moveDir = moveDir - camCF.LookVector
            end
            if uis:IsKeyDown(Enum.KeyCode.A) then
                moveDir = moveDir - camCF.RightVector
            end
            if uis:IsKeyDown(Enum.KeyCode.D) then
                moveDir = moveDir + camCF.RightVector
            end
            
            -- Nút UP / DOWN trên GUI hoặc phím Space/Ctrl
            if uis:IsKeyDown(Enum.KeyCode.Space) then
                moveDir = moveDir + Vector3.new(0, 1, 0)
            end
            if uis:IsKeyDown(Enum.KeyCode.LeftControl) then
                moveDir = moveDir - Vector3.new(0, 1, 0)
            end
            
            bv.velocity = moveDir * (speed * flySpeedMultiplier)
            bg.cframe = camCF
        end
    end)
end

local function stopFly()
    flying = false
    FlyToggleBtn.BackgroundColor3 = Color3.fromRGB(245, 240, 85) -- Trả về màu vàng ban đầu
    
    if bg then bg:Destroy() end
    if bv then bv:Destroy() end
    
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- Kết nối sự kiện các nút bấm chức năng
FlyToggleBtn.MouseButton1Click:Connect(function()
    if flying then
        stopFly()
    else
        startFly()
    end
end)

SpeedUpBtn.MouseButton1Click:Connect(function()
    speed = speed + 1
    SpeedLabel.Text = tostring(speed)
end)

SpeedDownBtn.MouseButton1Click:Connect(function()
    if speed > 1 then
        speed = speed - 1
        SpeedLabel.Text = tostring(speed)
    end
end)

-- Hỗ trợ giữ nút UP và DOWN trên GUI
local upHeld, downHeld = false, false
UpBtn.MouseButton1Down:Connect(function()
    upHeld = true
    task.spawn(function()
        while upHeld and flying do
            humanoidRootPart.CFrame = humanoidRootPart.CFrame + Vector3.new(0, 1, 0) * (speed * 0.5)
            task.wait()
        end
    end)
end)
UpBtn.MouseButton1Up:Connect(function() upHeld = false end)

DownBtn.MouseButton1Down:Connect(function()
    downHeld = true
    task.spawn(function()
        while downHeld and flying do
            humanoidRootPart.CFrame = humanoidRootPart.CFrame - Vector3.new(0, 1, 0) * (speed * 0.5)
            task.wait()
        end
    end)
end)
DownBtn.MouseButton1Up:Connect(function() downHeld = false end)
