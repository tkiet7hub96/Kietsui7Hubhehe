-- Hỗ trợ cuộn bằng chuột (Wheel) khi rê chuột vào menu
ScrollingFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        ScrollingFrame.CanvasPosition = ScrollingFrame.CanvasPosition - Vector2.new(0, input.Position.Z * 30)
    end
end)

-- Hiệu ứng chuyển màu cầu vồng liên tục cho viền menu
RunService.RenderStepped:Connect(function()
    local hue = tick() % 5 / 5
    RainbowStroke.Color = Color3.fromHSV(hue, 1, 1)
end)

-- Tính năng On/Off (Ẩn/Hiện bảng chính khi bấm nút Toggle)
local isOpen = true
ToggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    MainFrame.Visible = isOpen
    ToggleBtn.Text = isOpen and "Hide" or "Show"
end)
