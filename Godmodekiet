-- 6. Logic xử lý God Mode & Vòng tròn
local isGodModeEnabled = false
local activeConnection = nil

local function cleanupEffects()
    local character = player.Character
    if character then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local aura = rootPart:FindFirstChild("GodModeAura")
            if aura then aura:Destroy() end
        end
        local tag = character:FindFirstChild("GodModeConnectionTag")
        if tag then tag:Destroy() end
    end
    if activeConnection then
        activeConnection:Disconnect()
        activeConnection = nil
    end
end

local function applyGodMode()
    cleanupEffects()
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    -- Tạo hiệu ứng vòng tròn
    local existingVFX = rootPart:FindFirstChild("GodModeAura")
    if not existingVFX then
        local p = Instance.new("Part")
        p.Name = "GodModeAura"
        p.Size = Vector3.new(6, 0.2, 6)
        p.Shape = Enum.PartType.Cylinder
        p.Anchored = false
        p.CanCollide = false
        p.Transparency = 0.4
        p.BrickColor = BrickColor.new("Cyan")
        p.Material = Enum.Material.Neon
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rootPart
        weld.Part1 = p
        weld.Parent = p

        p.CFrame = rootPart.CFrame * CFrame.new(0, -3, 0)
        p.Parent = rootPart
    end

    -- Khóa máu tối đa
    activeConnection = humanoid.HealthChanged:Connect(function()
        if isGodModeEnabled and humanoid.Health < humanoid.MaxHealth then
            humanoid.Health = humanoid.MaxHealth
        end
    end)

    local tag = Instance.new("BoolValue")
    tag.Name = "GodModeConnectionTag"
    tag.Parent = character
end

