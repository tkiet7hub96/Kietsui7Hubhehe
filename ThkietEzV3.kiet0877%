local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ThkietEzV3"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local savedCFrame = nil
local savedCFrames = {}
local isMenuOpen = true

-- Thu nhỏ Menu chính (Từ 220x280 xuống 180x230)
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 180, 0, 230)
mainFrame.Position = UDim2.new(0.5, -90, 0.5, -115)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
mainFrame.BackgroundTransparency = 0.3
mainFrame.Parent = screenGui

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 15)
mainCorner.Parent = mainFrame

local mainStroke = Instance.new("UIStroke")
mainStroke.Thickness = 5
mainStroke.Parent = mainFrame

local mainGradient = Instance.new("UIGradient")
mainGradient.Color = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 255)),
    ColorSequenceKeypoint.new(0.2, Color3.fromRGB(0, 120, 255)),
    ColorSequenceKeypoint.new(0.4, Color3.fromRGB(170, 0, 255)),
    ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 0, 128)),
    ColorSequenceKeypoint.new(0.8, Color3.fromRGB(255, 128, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 255))
}
